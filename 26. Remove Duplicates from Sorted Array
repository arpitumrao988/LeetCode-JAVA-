//O(n)
class Solution {
    public int removeDuplicates(int[] nums) {
        if(nums.length==0)
        {
            return 0;
        }

       int element = nums[0];
       int currentLocation = 0;
       for(int i =0;i<nums.length;i++)
       {
            if(element!=nums[i])
            {
                currentLocation++;
                nums[currentLocation] = nums[i];
                element = nums[i];
            }
       } 
       return currentLocation +1;
    }
}
