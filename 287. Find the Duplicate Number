//brute force  O(n^2)
class Solution {
    public int findDuplicate(int[] nums) {
        for (int i=0;i<nums.length;i++)
        {
            for(int j=i+1;j<nums.length;j++)
            {
                if(nums[i]==nums[j])
                {
                    return nums[i];
                }
            }
        }
        return 0;
        
    }
}
//O(n)
class Solution {
    public int findDuplicate(int[] nums) {
        int max=0;
        for(int i=0;i<nums.length;i++)
        {
            if(nums[i]>max)
            {
                max=nums[i];
            }
        }
        int[] freq=new int[max+1];
        for(int i=0;i<=max;i++)
        {
            freq[nums[i]]++;
        }
        for(int i=0;i<=max;i++)
        {
            if(freq[i]>1)
            {
                return i;
            }
        }
        return 0;
        
    }
}
//////another one/////
class Solution {
    public int findDuplicate(int[] nums) {
        boolean[] arr=new boolean[nums.length];
        for(int i:nums)
        {
            if(arr[i])
            {
                return i;
            }
            else{
                arr[i]=true;
            }
        }
        return 0;
        
    }
}
