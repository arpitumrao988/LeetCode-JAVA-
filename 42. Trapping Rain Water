class Solution {
    public int trap(int[] height) {
        int result=0;
        int Lmax=0;
        int Rmax=0;
        int start=0;
        int end= height.length-1;
        while(start<end)
        {
            if (height[start]<=height[end])
            {
                if(Lmax>=height[start])
                {
                    result=result+(Lmax-height[start]);
                    start++;
                }
                else{
                    Lmax=height[start];
                    start++;
                }
            }
            else{
                
                if(Rmax>=height[end])
                {
                    result=result+(Rmax-height[end]);
                    end--;
                }
                else{
                    Rmax=height[end];
                    end--;
                }
                
            }
        }
        return result;

        
    }
}
