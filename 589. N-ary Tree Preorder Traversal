//iterative
class Solution {
    public List<Integer> preorder(Node root) {
      Stack<Node> st = new Stack<>();  
      List<Integer> ls = new ArrayList<>();
      if(root != null)
      {
        st.push(root);
      }else{
        return ls;
      }
      Node temp = root;
      while(!st.isEmpty())
      {     
        temp = st.pop();
        ls.add(temp.val);
        for(int i = temp.children.size()-1;i>=0;i--)
        {
            st.push(temp.children.get(i));
        }
      }
      return ls;
    }
}
//recursive
class Solution02 {
    public List<Integer> preorder(Node root) {
        List<Integer> ls = new ArrayList<>();
      Solution obj = new Solution();
      obj.preorder(root,ls);
      return ls;
    }
    public void preorder(Node root, List<Integer>ls)
    {
        if(root == null) return;
        ls.add(root.val);
        for(Node temp:root.children)
        {
            preorder(temp,ls);
        }
    }
}
