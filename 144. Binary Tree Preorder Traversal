/**
 * Definition for a binary tree node.
 * public class TreeNode {
 *     int val;
 *     TreeNode left;
 *     TreeNode right;
 *     TreeNode() {}
 *     TreeNode(int val) { this.val = val; }
 *     TreeNode(int val, TreeNode left, TreeNode right) {
 *         this.val = val;
 *         this.left = left;
 *         this.right = right;
 *     }
 * }
 */
class Solution01 {
    public List<Integer> preorderTraversal(TreeNode root) {
        List<Integer> ls = new ArrayList<>();
        Stack<TreeNode> st = new Stack<>();
        TreeNode temp = root;
        
    
        if(root != null)
        {
            st.push(root);
        }else{
            return ls;
        }
        while(!st.isEmpty())
        {
            temp =  st.pop();
            ls.add(temp.val);
            if(temp.right!= null){
                st.push(temp.right);
            }   
            if(temp.left!= null)
            {
                st.push(temp.left);
            }

        }
        return ls;
    }
}
