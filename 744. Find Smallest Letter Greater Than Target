class Solution {
    public char nextGreatestLetter(char[] letters, char target) {
        int start=0;
        int end=letters.length-1;
        if((int)target<(int)letters[0] || (int)target>=(int)letters[end])
        {
            return letters[0];
        }
        else{
            while(start<=end)
            {
                int mid=start+(end-start)/2;
                if((int)target<letters[mid])
                {
                    end=mid-1;
                }
                else{
                    start=mid+1;
                }
            }
            return letters[start];

        }
        
    }
}
