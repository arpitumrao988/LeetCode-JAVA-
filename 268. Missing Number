class Solution {
    public int missingNumber(int[] nums) {
     int l=nums.length;
     int[] arr=new int[l+1];
     for(int i=0;i<l;i++)
     {
        arr[nums[i]]++;
     }   
     for(int i=0;i<l+1;i++)
     {
        if(arr[i]==0)
        {
            return i;
        }
     }
     return -1;
    }
}
