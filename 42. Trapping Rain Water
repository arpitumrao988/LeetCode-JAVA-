//O(n)
class Solution {
    public int trap(int[] height) {
        int size = height.length;
        int[] leftMax = new int[size];
        int[] rightMax = new int[size];
        int currentMax = 0;
//for left max
        for(int i =0;i<size;i++)  
        {
            if(currentMax<height[i])
            {
                currentMax = height[i];
                leftMax[i] = currentMax;
            }
            else{
                leftMax[i] = currentMax;
            }
        }
        currentMax = 0;
 //for rigth max
        for(int i =size-1;i>=0;i--)
        {
            if(currentMax<height[i])
            {
                currentMax = height[i];
                rightMax[i] = currentMax;
            }
            else{
                rightMax[i] = currentMax;
            }
        }
        int result = 0;
        for(int i =0;i<size;i++)
        {
            result +=Math.min(leftMax[i],rightMax[i]) - height[i];
        }
        return result;
    }
}

//using single stack
class Pair{
    int a;
    int b ;
    Pair(int a, int b)
    {
        this.a = a;
        this.b = b;
    }
}
class Solution {

    public int trap(int[] height) {
        Stack<Pair> st = new Stack<>();
        int leftMax = 0;
        for(int i =0;i<height.length;i++)
        {
            if(leftMax < height[i])
            {
                leftMax = height[i];
            }
            st.push(new Pair(height[i],leftMax));
        }
        int result =0;
        int rightMax = 0;
        for(int  i =0;i<height.length;i++)
        {
            if(rightMax<st.peek().a)
            {
                rightMax = st.peek().a;
            }
            result +=Math.min(rightMax,st.peek().b) - height[i];
            st.pop();
        }
        return result;
    }
}
