/**
 * Definition for a binary tree node.
 * public class TreeNode {
 *     int val;
 *     TreeNode left;
 *     TreeNode right;
 *     TreeNode() {}
 *     TreeNode(int val) { this.val = val; }
 *     TreeNode(int val, TreeNode left, TreeNode right) {
 *         this.val = val;
 *         this.left = left;
 *         this.right = right;
 *     }
 * }
 */
 class Info{
    int height ;
    int result;
    Info(int height, int result)
    {
        this.height = height;
        this.result = result;
    }
 }
class Solution {
    private int p = 0;
    public int diameterOfBinaryTree(TreeNode root) {
      return maxHeight(root).result;
    }
    private Info maxHeight(TreeNode root)
    {
        if(root == null ) return new Info(0,0);
        Info left= maxHeight(root.left);
        Info right = maxHeight(root.right);
        p = Math.max(p,left.height+right.height);
        return new Info(1+Math.max(left.height,right.height),p);
    }
}
