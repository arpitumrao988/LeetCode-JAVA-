/**
 * Definition for a binary tree node.
 * public class TreeNode {
 *     int val;
 *     TreeNode left;
 *     TreeNode right;
 *     TreeNode() {}
 *     TreeNode(int val) { this.val = val; }
 *     TreeNode(int val, TreeNode left, TreeNode right) {
 *         this.val = val;
 *         this.left = left;
 *         this.right = right;
 *     }
 * }
 */
 class Info{
    boolean status;
    int size;
    Info(boolean status,int size)
    {
        this.status = status;
        this.size = size;
    }
 }
class Solution {
    List<Integer>size = new ArrayList<>();
    public int kthLargestPerfectSubtree(TreeNode root, int k) {
        check(root);
        Collections.sort(size);
        if(size.size()<k)return -1;
        return size.get(size.size()-k);
    }
    private Info check(TreeNode root)
    {
        //base case
        if(root == null)
        {
            return new Info(true,0);
        }

        Info left = check(root.left);
        Info right = check(root.right);
        if(left.status && right.status && left.size == right.size)
        {
            size.add(left.size+right.size+1);
        }
        return new Info(left.status && right.status && left.size == right.size,left.size+right.size+1);
    }
}
