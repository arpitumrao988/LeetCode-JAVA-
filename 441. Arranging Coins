//O(log(n))
class Solution {
    public int arrangeCoins(int n) {
       long start=1;
       long end=n;
       while(start<=end)
       {
        long mid=start+(end-start)/2;
        if(n<(mid*(mid+1))/2)
        {
            end=mid-1;
        }
        else{
            start=mid+1;
        }
       }
       return (int)end;
    }
}
//another approach
//O(sqrt(n))
class Solution {
    public int arrangeCoins(int n) {
        int i=1;
       while(n>=i)
       {
        n=n-i;
        i++;
       }
       return i-1;
    }
}
