class Solution {
    public boolean searchMatrix(int[][] matrix, int target) {

        return binarySearch(matrix, target, rowNo(matrix, target));

    }

    boolean binarySearch(int[][] arr, int target, int row) {
        if (row < 0)
            return false;
        int low = 0;
        int high = arr[row].length - 1;
        System.out.println(row);
        while (low <= high) {
            int mid = low + (high - low) / 2;
            if (arr[row][mid] == target)
                return true;
            else if (arr[row][mid] > target)
                high = mid - 1;
            else
                low = mid + 1;
        }
        return false;
    }

    int rowNo(int[][] arr, int target) {
        int low = 0;
        int high = arr.length - 1;
        int mid = 0;
        while (low <= high) {
            mid = low + (high - low) / 2;
            if (arr[mid][0] == target)
                return mid;
            else if (arr[mid][0] < target)
                low = mid + 1;
            else
                high = mid - 1;
        }
        return high;

    }
}
