//O(n) 
class Solution {
    public int pivotIndex(int[] nums) {
        int n = nums.length;
        int[] leftSum =new int[n];
        leftSum[0]= nums[0];
        int[] rightSum =new int[n];
        rightSum[n-1]= nums[n-1];
        
        for(int i =0;i<n-1;i++)
        {
            leftSum[i+1] = leftSum[i]+nums[i+1];
            rightSum[n-2-i]= rightSum[n-1-i]+nums[n-2-i];
        }
        for(int i =0;i<n;i++)
        {
            if(leftSum[i]==rightSum[i])
            {
                return i;
            }
        }
        return -1;
    }
}
