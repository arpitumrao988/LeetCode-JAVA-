class Solution {
    public int[] fairCandySwap(int[] aliceSizes, int[] bobSizes) {
       int aliceTotal=0;
       int bobTotal=0;
       for(int i: aliceSizes){
        aliceTotal+=i;
       } 
       for(int i:bobSizes)
       {
        bobTotal+=i;
       }
       Arrays.sort(bobSizes);
       int n=0;
       if(aliceTotal>bobTotal)
       {
        n=(aliceTotal-bobTotal)/2;
       }
       else{
        n=(bobTotal-aliceTotal)/2;
       }
       for(int i=0;i<aliceSizes.length;i++)
       {
            if(aliceTotal>bobTotal){
                boolean p=binarySearch(bobSizes,aliceSizes[i]-n);
                if(p){
            return new int[]{aliceSizes[i],aliceSizes[i]-n};
            } }
            else{
                boolean p=binarySearch(bobSizes,aliceSizes[i]+n);
                if(p){
            return new int[]{aliceSizes[i],aliceSizes[i]+n};}};
            }
        return new int[]{};
       }
       public static boolean binarySearch(int[] arr,int target)
       {
        int start=0;
        int end=arr.length-1;
        while(start<=end){
            int mid=start+(end-start)/2;
        if(arr[mid]==target)
        {
            return true;
        }
        else if(target < arr[mid])
        {
            end=mid-1;
        }
        else{
            start=mid+1;
        }
        } 
        return false;
       }
    
}
