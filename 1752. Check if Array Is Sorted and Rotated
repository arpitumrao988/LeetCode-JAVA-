//O(n)
class Solution {
    public void reverse(int[]  nums, int left, int right)
    {
        while(left<right){
            int temp = nums[left];
            nums[left]= nums[right];
            nums[right] = temp;
            left++;
            right--;
        }
    }
    public boolean check(int[] nums) {
        int breakPoint = 0;
        if(nums.length<=1)return true;
        for(int i =0;i<nums.length-1;i++)
        {
            if(!(nums[i]<=nums[i+1])){
                breakPoint = i+1;System.out.println(breakPoint);
                break;
            }
        }
        Solution obj = new Solution();
        obj.reverse(nums,0,breakPoint-1);
        obj.reverse(nums,breakPoint,nums.length-1);
        for(int i =0;i<nums.length-1;i++)
        {
            if(nums[i]<nums[i+1]) return false;
        }
        return true;
    }
}
