class Solution {
    public String reverseOnlyLetters(String s) {
        char[] arr=s.toCharArray();
        int start=0;
        int end=arr.length-1;
        while(start<=end)
        {
            if(isAlpha(arr[start]) && isAlpha(arr[end]))
            {
                char temp=arr[start];
                arr[start]=arr[end];
                arr[end]=temp;
                start++;
                end--;
            }
            else{
                if(!isAlpha(arr[start]))
                {
                    start++;
                    
                }
                if(!isAlpha(arr[end]))
                {
                    end--;
                   
                }
            }
        }
        return new String(arr);
    }
        
    public static boolean isAlpha(char ch)
    {
        if((ch>='a' && ch<='z') || (ch>='A' && ch<='Z'))
        {
            return true;
        }
        return false;
    }
}
