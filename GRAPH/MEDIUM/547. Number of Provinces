//bfs
class Solution {
    public int findCircleNum(int[][] isConnected) {
        int size = isConnected.length;
        int componant = 0;
        int[] visit = new int[size];
        Arrays.fill(visit,0);
        for(int i =0;i<size;i++)
        {
            if(visit[i]== 0)
            {
                componant++;
                Queue<Integer>q1 = new LinkedList<>();
                q1.offer(i);
                visit[i] = 1;
                while(!q1.isEmpty())
                {
                    int x = q1.poll();
                    for(int j =0;j<size;j++)
                    {
                        if(isConnected[x][j]==1 && visit[j]==0){
                        visit[j] = 1;
                        q1.offer(j);}
                    }
                }

            }
        }
        return componant;
    }
}