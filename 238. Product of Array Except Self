//Time complexity = O(n)
//SpaceComplexity = O(n)
class Solution1 {
    public int[] productExceptSelf(int[] nums) {
        int n = nums.length;
        int[] result = new int[n];
        int[] leftProduct = new int[n];
        leftProduct[0] = nums[0];
        int[] rightProduct = new int[n];
        rightProduct[n-1] = nums[n-1];
        for(int i =0;i<n-1;i++)
        {
            leftProduct[i+1] = leftProduct[i]*nums[i+1];
            rightProduct[n-2-i] = rightProduct[n-1-i] * nums[n-2-i];
        }
            result[0]= rightProduct[1];
            result[n-1]= leftProduct[n-2];
            for(int i =1;i<n-1;i++)
            {
                result[i] = leftProduct[i-1]*rightProduct[i+1];
            }
            return result;
    }
}
//Time complexity = O(n)
//SpaceComplexity = O(1) (if result array is not count)
class Solution {
    public int[] productExceptSelf(int[] nums) {
            int n = nums.length;
            int[] result = new int[n];
            result[0]  =1 ;
            
            int leftProduct = 1;
            int rightProduct = 1;
            for(int i =0;i<n-1;i++)
            {
                leftProduct *= nums[i];
                result[i+1] = leftProduct;
            }
            for(int i =0;i<n-1;i++)
            {
                rightProduct *= nums[n-1-i];
                result[n-2-i] *= rightProduct;
            }
            return result;
    }
}
