//O(n)
class Solution {
    public int findMaxConsecutiveOnes(int[] nums) {
        int max = Integer.MIN_VALUE;
        int count = 0;
        for(int i =0;i<nums.length;i++)
        {
            if(1 == nums[i])
            {
                count++;
                if(max<count){
                    max = count;
                }
            }
            else{
                
                count = 0;
            }
        }
        if(max == Integer.MIN_VALUE)
        {
            return 0;
        }
        return  max;
    }
}
