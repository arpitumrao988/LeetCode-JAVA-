class Solution {

    public List<List<Integer>> shiftGrid(int[][] grid, int k) {

        int m = grid.length;
        int n = grid[0].length;

        int size = m * n;
        k %= size;

        int[] arr = new int[size];

        int p = 0;

        // Convert 2D -> 1D
        for(int i = 0; i < m; i++)
        {
            for(int j = 0; j < n; j++)
            {
                arr[p++] = grid[i][j];
            }
        }

        // Right rotation
        reverse(arr,0,size-1);
        reverse(arr,0,k-1);
        reverse(arr,k,size-1);

        // Convert 1D -> 2D
        p = 0;
        for(int i = 0; i < m; i++)
        {
            for(int j = 0; j < n; j++)
            {
                grid[i][j] = arr[p++];
            }
        }

        List<List<Integer>> ans = new ArrayList<>();

        for(int i = 0; i < m; i++)
        {
            List<Integer> row = new ArrayList<>();

            for(int j = 0; j < n; j++)
            {
                row.add(grid[i][j]);
            }

            ans.add(row);
        }

        return ans;
    }

    public void reverse(int[] arr,int start,int end)
    {
        while(start < end)
        {
            int temp = arr[start];
            arr[start] = arr[end];
            arr[end] = temp;

            start++;
            end--;
        }
    }
}
